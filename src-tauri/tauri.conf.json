{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Facet",
  "version": "0.1.0",
  "identifier": "net.ytakahashi.facet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Facet",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "../build/icon.icns"
    ]
  }
}
