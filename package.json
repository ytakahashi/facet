{
  "name": "facet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "fmt": "vp fmt",
    "test": "vp test run && deno test --allow-read --allow-write --allow-run",
    "desktop": "tauri build",
    "desktop:dev": "tauri dev",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "mkdir -p dist && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "mkdir -p dist && cargo test --locked --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "mermaid": "12.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.11.0",
      "onFail": "download"
    }
  }
}
