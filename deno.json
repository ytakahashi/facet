{
  "desktop": {
    "app": {
      "name": "Facet",
      "identifier": "net.ytakahashi.facet",
      "icons": {
        "macos": "./build/icon.icns"
      }
    },
    "backend": "webview"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http/file-server": "jsr:@std/http@^1/file-server"
  },
  "test": {
    "include": [
      "desktop/",
      ".agents/skills/manage-facet-board/scripts/"
    ]
  },
  "tasks": {
    "desktop": "tauri build",
    "desktop:dev": "tauri dev",
    "test": "vitest run && deno test --allow-read --allow-write --allow-run",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "mkdir -p dist && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "mkdir -p dist && cargo test --locked --manifest-path src-tauri/Cargo.toml"
  }
}
