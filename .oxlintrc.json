{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  // Enforces the import directions ARCHITECTURE.md describes, including the
  // process boundary between src/ and desktop/.
  //
  // Patterns match the import specifier as written, so they are anchored with
  // `**/` rather than spelled relatively: `../usecase/*` stops matching the
  // moment a layer gains a subdirectory and one more `../` appears, which
  // would drop the boundary without failing any check.
  //
  // A more specific override replaces this rule rather than merging into it,
  // so each layer restates every boundary that applies to it.
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": ["**/desktop/**"]
        }]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/usecase/**",
            "**/infrastructure/**",
            "**/presentation/**",
            "**/composition/**",
            "**/desktop/**"
          ]
        }]
      }
    },
    {
      "files": ["src/usecase/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/presentation/**",
            "**/composition/**",
            "**/desktop/**"
          ]
        }]
      }
    },
    {
      "files": ["src/infrastructure/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/usecase/**",
            "**/presentation/**",
            "**/composition/**",
            "**/desktop/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**"
          ]
        }]
      }
    },
    // Keep these after src/presentation/**: the last matching override wins.
    // Patterns match directory names in import specifiers, so adding a
    // directory such as domain/search/ would also restrict imports of it.
    {
      "files": ["src/presentation/shared/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/labels/**",
            "**/kanban/**",
            "**/table/**",
            "**/search/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/labels/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/kanban/**",
            "**/table/**",
            "**/search/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/kanban/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/table/**",
            "**/search/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/table/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/kanban/**",
            "**/search/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/search/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/kanban/**",
            "**/table/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/filter/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/kanban/**",
            "**/table/**",
            "**/search/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/viewer/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/kanban/**",
            "**/table/**",
            "**/search/**",
            "**/filter/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/board/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["src/presentation/shell/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/board/**"
          ]
        }]
      }
    },
    {
      "files": [
        "src/presentation/context/**",
        "src/presentation/errors/**",
        "src/presentation/store/**"
      ],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            "**/infrastructure/**",
            "**/composition/**",
            "**/desktop/**",
            "**/shared/**",
            "**/labels/**",
            "**/kanban/**",
            "**/table/**",
            "**/search/**",
            "**/filter/**",
            "**/viewer/**",
            "**/board/**",
            "**/shell/**"
          ]
        }]
      }
    },
    {
      "files": ["desktop/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": ["**/src/**"]
        }]
      }
    }
  ]
}
